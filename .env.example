# Ozon Seller API
OZON_CLIENT_ID=
OZON_API_KEY=

# Optional: Ozon Performance API (advertising)
OZON_PERF_CLIENT_ID=
OZON_PERF_API_KEY=

# Wildberries: personal API token for the local application
WB_API_TOKEN=

# Optional: local AI analytics via Ollama (defaults shown)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_NUM_CTX=32768        # context window in tokens; Ollama's own default (4096) truncates report data
# OLLAMA_KEEP_ALIVE=30m       # keep the model loaded between questions
# OLLAMA_THINK=               # 1 / 0 to force thinking on / off; empty = model default
# OLLAMA_READ_TIMEOUT=600     # seconds to wait for a reply

# Optional: Ozon search results parser (positions by region), off by default.
# Setup: scripts/serp_profile.py setup, then create region profiles — see README.
# SERP_PARSER_ENABLED=1
# Optional proxy per region (name it in: scripts/serp_profile.py create spb "Санкт-Петербург" --proxy-env SERP_PROXY_SPB)
# SERP_PROXY_SPB=http://user:password@host:port
